-- cp_for_nested1 --
for k, v in x {
	for k2, _ in v {
		(k): _
	}
}

x: {
	a: {i1: 1}
}
-- exp --
x: {
    a: {
        i1: 1
    }
}
a: _

-- cp_for_nested2 --
for k, v in x {
	for k2, _ in v {
		(k): _
	}
}

x: {
	a: {i1: 1}
	b: {j1: 3}
}
-- exp --
x: {
    a: {
        i1: 1
    }
    b: {
        j1: 3
    }
}
a: _
b: _

-- cp_for_nested3 --
for k, v in x {
	for k2, _ in v {
		(k): _
	}
}

x: {
	a: {i1: 1, i2: 2}
	b: {j1: 3}
}
-- exp --
x: {
    a: {
        i1: 1
        i2: 2
    }
    b: {
        j1: 3
    }
}
a: _
b: _

-- cp_for_nested4 --
x: {
	for k, v in {l1: 10, l2: 20} {
		for k, v2 in {m1: v, m2: v + 1} {
			"\(k)_\(v2)": v2
		}
	}
}

-- exp --
x: {
    m1_10: 10
    m2_11: 11
    m1_20: 20
    m2_21: 21
}

