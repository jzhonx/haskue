cabal-version: 3.0
name: haskue-show-trace
version: 0.1.0.0
synopsis: View Haskue traces in the Perfetto web UI
description: Serve Haskue's newline-delimited JSON traces to the Perfetto web UI.
license: Apache-2.0
author: Junxiang Zhou
maintainer: junzhou365@gmail.com
category: Development

executable haskue-show-trace
  main-is: Main.hs
  hs-source-dirs:
    app
    src
  other-modules:
    ShowTrace.Server
  build-depends:
    base >= 4.18 && < 4.22,
    bytestring >= 0.11 && < 0.13,
    directory >= 1.3 && < 1.4,
    filepath >= 1.4 && < 1.6,
    http-types >= 0.12 && < 0.13,
    optparse-applicative >= 0.18 && < 0.20,
    text >= 2.0 && < 2.2,
    wai >= 3.2 && < 3.3,
    wai-cors >= 0.2 && < 0.3,
    warp >= 3.3 && < 3.5
  default-language: Haskell2010
  ghc-options: -Wall -Wpartial-fields -threaded
